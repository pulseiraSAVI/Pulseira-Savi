/**
 * firestore.rules — SAVI (Sistema de Acesso Virtual a Informação Clínica)
 * Pivô de produção, revisão de 15/09/2026. Substitui por completo o
 * modelo anterior (família/profissional clínico/equipa administradora/
 * auditor) — ver CLAUDE.md, secção "Pivô para produção".
 *
 * Princípio geral: negar tudo por defeito. Cada coleção é aberta apenas
 * com a regra mínima necessária para o papel em causa.
 *
 * Custom claims esperadas no ID token do Firebase Auth (definidas no
 * momento da criação da conta pelo superadmin, nunca editáveis pelo
 * próprio utilizador):
 *   - papeis: array<string>  — subconjunto de 'profissional' | 'utilizador' | 'superadmin'
 *   - funcao_auditor: boolean (só tem efeito quando papeis contém 'superadmin')
 *   - profissional_id: string  (id do próprio documento em /profissionais)
 *
 * IMPORTANTE — o fluxo de break-glass (os 3 métodos de acesso, papel
 * 'utilizador') NUNCA passa por aqui: o frontend fala sempre com o
 * Cloudflare Worker (backend/cloudflare-worker), que usa uma service
 * account com acesso direto ao Firestore (via REST API/Admin SDK) e não
 * fica sujeito a estas regras do lado do cliente. Estas regras protegem
 * apenas o acesso direto ao Firestore feito pela app de profissional/
 * superadmin (nunca pelo frontend do papel 'utilizador').
 *
 * A família está suspensa nesta revisão — sem custom claim própria, sem
 * regras de família nesta versão do documento.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Funções auxiliares
    // ------------------------------------------------------------------

    function autenticado() {
      return request.auth != null;
    }

    function papeis() {
      return request.auth.token.papeis;
    }

    function temPapel(p) {
      return autenticado() && (p in papeis());
    }

    function isProfissional() {
      return temPapel('profissional');
    }

    function isSuperadmin() {
      return temPapel('superadmin');
    }

    function isAuditor() {
      // Sub-papel dentro do superadmin (funcao_auditor = true).
      return isSuperadmin() && request.auth.token.funcao_auditor == true;
    }

    // Um profissional só pode aceder aos pacientes que ele próprio criou;
    // o superadmin não tem essa restrição.
    function ehCriadorDoPaciente(pacienteId) {
      return isProfissional() &&
        get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.criado_por_id == request.auth.token.profissional_id;
    }

    function podeGerirPaciente(pacienteId) {
      return isSuperadmin() || ehCriadorDoPaciente(pacienteId);
    }

    // ------------------------------------------------------------------
    // dados_nivel1 — dados clínicos essenciais (o coração do sistema)
    // Documento por paciente: /dados_nivel1/{pacienteId}
    // Leitura pelo papel 'utilizador' (break-glass) NUNCA passa por aqui
    // — vai sempre através do Worker, com a service account. Estas
    // regras cobrem só o acesso direto da app de profissional/superadmin.
    // ------------------------------------------------------------------
    match /dados_nivel1/{pacienteId} {
      allow read: if podeGerirPaciente(pacienteId);
      allow write: if podeGerirPaciente(pacienteId);
    }

    // ------------------------------------------------------------------
    // pacientes — dados administrativos/identificativos (não clínicos)
    // ------------------------------------------------------------------
    match /pacientes/{pacienteId} {
      // Superadmin: acesso total.
      allow read, write: if isSuperadmin();

      // Profissional: só o(s) paciente(s) que ele próprio criou.
      allow read, update, delete: if ehCriadorDoPaciente(pacienteId);

      // Criação: qualquer profissional pode criar um paciente novo, desde
      // que se registe a si próprio como criado_por_id (nunca em nome de
      // outro profissional).
      allow create: if isProfissional() &&
        request.resource.data.criado_por_id == request.auth.token.profissional_id;
    }

    // ------------------------------------------------------------------
    // documentos — referências aos ficheiros digitalizados (RGPD + termo
    // de responsabilidade) no Firebase Storage
    // ------------------------------------------------------------------
    match /documentos/{documentoId} {
      allow read, write: if isSuperadmin();
      // Profissional: só documentos de pacientes que criou. Como não há
      // paciente_id disponível em resource.data para um create ainda não
      // validado noutra coleção, confia-se no campo enviado no próprio
      // pedido (request.resource.data.paciente_id) e verifica-se a posse.
      allow read, write: if isProfissional() &&
        ehCriadorDoPaciente(resource.data.paciente_id);
      allow create: if isProfissional() &&
        ehCriadorDoPaciente(request.resource.data.paciente_id);
    }

    // ------------------------------------------------------------------
    // acessos — audit log do break-glass (ISO 27789:2021)
    // ------------------------------------------------------------------
    match /acessos/{acessoId} {
      // Escrita: NUNCA diretamente do cliente. Este registo é criado
      // exclusivamente pelo Cloudflare Worker, autenticado com uma
      // service account (Admin SDK) — por segurança em profundidade,
      // bloqueia-se explicitamente qualquer escrita vinda de um ID token
      // de utilizador final.
      allow write: if false;

      // Leitura: reservada a quem tem funcao_auditor==true (sub-papel do
      // superadmin), ou ao superadmin em geral.
      allow read: if isAuditor() || isSuperadmin();
    }

    // ------------------------------------------------------------------
    // profissionais — contas dos profissionais/utilizadores/superadmin.
    // Gestão exclusiva do superadmin (secção "Contas").
    // ------------------------------------------------------------------
    match /profissionais/{profissionalId} {
      allow read, write: if isSuperadmin();
      // Cada conta pode ler o seu próprio documento (para mostrar o nome,
      // papéis, etc. na app) — nunca escrever (pin_hash e papéis só
      // mudam pela mão do superadmin).
      allow read: if autenticado() && request.auth.token.profissional_id == profissionalId;
    }

    // ------------------------------------------------------------------
    // lotes, pulseiras — gestão exclusiva do superadmin/profissional
    // ------------------------------------------------------------------
    match /lotes/{loteId} {
      allow read, write: if isSuperadmin();
    }

    match /pulseiras/{pulseiraId} {
      allow read, write: if isSuperadmin();
      // O profissional pode ler pulseiras dos pacientes que criou (para
      // "Solicitar pulseira") e atribuir uma pulseira não atribuída a um
      // desses pacientes — nunca a pacientes de outro profissional.
      allow read: if isProfissional() &&
        (resource.data.paciente_id == null || ehCriadorDoPaciente(resource.data.paciente_id));
      allow update: if isProfissional() &&
        resource.data.estado == 'nao_atribuida' &&
        ehCriadorDoPaciente(request.resource.data.paciente_id);
      // Nota: o Worker consulta pulseiras pelo token durante o break-glass
      // com a service account (fora do alcance destas regras).
    }

    // ------------------------------------------------------------------
    // contas_familia, familia_paciente — SUSPENSAS nesta revisão (ver
    // "Pivô para produção", CLAUDE.md). Sem uso: bloqueadas por defeito,
    // tal como qualquer outra coleção não listada.
    // ------------------------------------------------------------------

    // ------------------------------------------------------------------
    // Negação por defeito: qualquer coleção não listada acima (incluindo
    // contas_familia, familia_paciente, e futuras coleções de Fase 2/4
    // como instituicoes, consultas_validacao — ver firestore-schema.md)
    // fica bloqueada.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
